# Optionnel : cache persistant (sinon cache mémoire)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optionnel : paroles non synchronisées (fallback) via Genius
GENIUS_TOKEN=

# proxy = flux audio relayé par l'addon (sous-titres OK) | ytid = lecteur YouTube de Stremio (test)
STREAM_MODE=proxy

# URL publique de l'addon (sinon déduite de la requête)
BASE_URL=
