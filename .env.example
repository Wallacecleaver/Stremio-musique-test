# Optionnel : cache persistant (sinon cache mémoire)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optionnel : paroles non synchronisées (fallback) via Genius
GENIUS_TOKEN=

# on = ajoute un flux "Relais" (audio relayé par le serveur). À réserver à un VPS :
# YouTube bloque les IP de Vercel. Laisser vide ailleurs.
AUDIO_RELAY=

# URL publique de l'addon (sinon déduite de la requête)
BASE_URL=
